<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metricplatform.persistence.mapper.DataSourceMapper">
    <select id="selectAllIncludingDeleted"
            resultType="com.metricplatform.persistence.entity.DataSourceEntity">
        SELECT *
        FROM data_source
        ORDER BY name
