<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metricplatform.persistence.mapper.DimensionTimeGranularityMapper">
    <insert id="insertGranularity">
        INSERT INTO dimension_time_granularity (dimension_id, granularity)
        VALUES (#{dimensionId}, #{granularity})
    </insert>

    <select id="selectByDimensionId"
            resultType="com.metricplatform.persistence.entity.DimensionTimeGranularityEntity">
        SELECT dimension_id, granularity
        FROM dimension_time_granularity
        WHERE dimension_id = #{dimensionId}
        ORDER BY granularity
    </select>

    <delete id="deleteByDimensionId">
        DELETE FROM dimension_time_granularity
        WHERE dimension_id = #{dimensionId}
    </delete>
</mapper>
