<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metricplatform.persistence.mapper.PlatformIdentityDatasetGrantMapper">
    <delete id="physicallyDeleteByIdentityId">
        DELETE FROM platform_identity_dataset_grant
        WHERE identity_id = #{identityId}
    </delete>
</mapper>
